{
  "name": "hello-electron",
  "productName": "Hello Electron",
  "version": "0.0.1",
  "description": "Hello Electron — cross-platform desktop app (Electron + TypeScript)",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:wsl-server": "vite build --config vite.wsl-server.config.ts",
    "wsl-server:start": "npm run build:wsl-server && node dist/wsl-server/index.js",
    "wsl-server:stop": "kill $(cat .wsl-server.pid) 2>/dev/null; rm -f .wsl-server.pid; echo done"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "electron": "43.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
