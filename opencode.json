{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/context/README.md",
    ".opencode/context/workflow.md",
    ".opencode/context/issue-register.md",
    ".opencode/context/session-state.md",
    "docs/setup.md",
    "docs/architecture.md",
    "docs/tech-stack.md",
    "docs/decisions.md",
    "docs/plan.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --check": "allow",
      "git diff --stat": "allow",
      "git log --oneline -10": "allow",
      "git branch --show-current": "allow",
      "git rev-parse --show-toplevel": "allow"
    }
  }
}
